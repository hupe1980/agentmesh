{
  "name": "AgentMesh",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "The API key for accessing OpenAI services"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GOPATH": "/go",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.gopath": "/go",
        "go.toolsManagement.autoUpdate": true,
        "go.formatTool": "gofmt"
      },
      "extensions": [
        "golang.go",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "postCreateCommand": "go mod tidy"
}
